{
  "name": "@iamsdr/ocp",
  "version": "0.2.1",
  "description": "Simple OpenCode plugin that connects any OpenAI-compatible /v1 endpoint and auto-loads its models.",
  "type": "module",
  "license": "MIT",
  "author": "IAMSDR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAMSDR/ocp.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ocp": "dist/bin/setup.js",
    "ocp-setup": "dist/bin/setup.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && vitest run",
    "test:watch": "vitest",
    "prepare": "tsc"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.15",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openai-compatible",
    "llm",
    "provider"
  ]
}
